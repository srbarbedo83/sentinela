{
    "dry_run": true,
    "dry_run_wallet": 1000,

    "trading_mode": "spot",
    "margin_mode": "",

    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "max_open_trades": 3,

    "timeframe": "1h",

    "minimal_roi": {
        "0": 0.10
    },
    "stoploss": -0.10,

    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },
    "unfilledtimeout": {
        "entry": 2,
        "exit": 2,
        "unit": "minutes"
    },

    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "options": {
                "fetchCurrencies": false
            }
        },
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT",
            "PENDLE/USDT"
        ],
        "pair_blacklist": []
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },

    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "jwt_secret_key": "SUBSTITUIR_POR_STRING_ALEATORIA",
        "CORS_origins": [],
        "username": "sentinela",
        "password": "SUBSTITUIR_POR_PASSWORD_FORTE"
    },

    "bot_name": "sentinela",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    }
}
