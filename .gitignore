# Ficheiro real de configuracao - contem (ou vira a conter) segredos.
# Copia user_data/config.json.example para user_data/config.json localmente.
user_data/config.json
user_data/config-*.json
!user_data/config.json.example

# Dados, logs e resultados gerados localmente
user_data/logs/*.log
user_data/data/*
!user_data/data/.gitkeep
user_data/*.sqlite
user_data/*.sqlite-journal
user_data/backtest_results/
user_data/hyperopt_results/
user_data/notebooks/

# Segredos diversos
.env
*.pem
*.key
